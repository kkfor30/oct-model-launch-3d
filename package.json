    "@types/three": "^0.169.0",
    "postprocessing": "^6.36.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.242",
    "three": "^0.169.0",
    "typescript": "^5.6.3"
  }
