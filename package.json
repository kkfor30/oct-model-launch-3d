  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts Launch out/still.png --gl=angle",
    "score": "python audio/score_v5_drive.py 63.3667 out/score.wav",
    "render": "remotion render src/index.ts Launch out/video.mp4 --gl=angle --concurrency=2 --timeout=120000 --muted",
    "mux": "ffmpeg -y -i out/video.mp4 -i out/score.wav -map 0:v -map 1:a -c:v copy -c:a aac -b:a 256k -shortest out/final.mp4"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
